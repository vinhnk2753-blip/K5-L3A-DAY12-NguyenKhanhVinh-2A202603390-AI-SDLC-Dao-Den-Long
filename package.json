{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node dist-cli/cli/run.js",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:web": "vite build",
    "build": "npm run build:cli && npm run build:web",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "soak": "node --expose-gc --max-semi-space-size=4 dist-cli/cli/soak.js --seed 7 --nights 10 --out soak.json",
    "bench": "node dist-cli/cli/bench.js --seed 42 --duration 30 --out bench.json",
    "verify": "node scripts/verify-gate.mjs"
  },
  "dependencies": {
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/three": "^0.174.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
